#!/bin/bash
set -euo pipefail

REPOS="https://raw.githubusercontent.com/dex827191/v4/main/"

ns_domain_cloudflare() {
    DOMAIN="buyerserverpremium.web.id"
    DOMAIN_PATH=$(cat /etc/xray/domain)
    SUB=$(cat /etc/xray/domain | cut -d "." -f1)
    SUB_DOMAIN=${SUB}."buyerserverpremium.web.id"
    NS_DOMAIN="ns-${SUB_DOMAIN}"
    CF_ID="ptrajaserverpremium@gmail.com"
    CF_KEY="8d38e5ab5ee2d6f939c9f75c29fe9171936f6"
    IP=$(cat /usr/bin/ipsave)

    echo "Updating DNS NS for ${NS_DOMAIN}..."
    ZONE=$(
        curl -sLX GET "https://api.cloudflare.com/client/v4/zones?name=${DOMAIN}&status=active" \
            -H "X-Auth-Email: ${CF_ID}" \
            -H "X-Auth-Key: ${CF_KEY}" \
            -H "Content-Type: application/json" | jq -r .result[0].id
    )
    RECORD=$(
        curl -sLX GET "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records?name=${NS_DOMAIN}" \
            -H "X-Auth-Email: ${CF_ID}" \
            -H "X-Auth-Key: ${CF_KEY}" \
            -H "Content-Type: application/json" | jq -r .result[0].id
    )
    if [[ "${#RECORD}" -le 10 ]]; then
        RECORD=$(
            curl -sLX POST "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records" \
                -H "X-Auth-Email: ${CF_ID}" \
                -H "X-Auth-Key: ${CF_KEY}" \
                -H "Content-Type: application/json" \
                --data '{"type":"NS","name":"'${NS_DOMAIN}'","content":"'${DOMAIN_PATH}'","proxied":false}' | jq -r .result.id
        )
    fi
    RESULT=$(
        curl -sLX PUT "https://api.cloudflare.com/client/v4/zones/${ZONE}/dns_records/${RECORD}" \
            -H "X-Auth-Email: ${CF_ID}" \
            -H "X-Auth-Key: ${CF_KEY}" \
            -H "Content-Type: application/json" \
            --data '{"type":"NS","name":"'${NS_DOMAIN}'","content":"'${DOMAIN_PATH}'","proxied":false}'
    )
    echo $NS_DOMAIN >/etc/xray/dns
}

# >>> REVISI BUILD DARI SOURCE
setup_dnstt() {
    echo "Preparing dnstt from source (Go build)..."

    # 1. Pastikan dependensi build tersedia
    if ! command -v git &>/dev/null || ! command -v go &>/dev/null; then
        echo "Installing git & golang-go..."
        apt-get update -y && apt-get install -y git golang-go ca-certificates
    fi

    # 2. Clone repositori resmi dnstt
    rm -rf /tmp/dnstt-build
    git clone --depth 1 https://www.bamsoftware.com/git/dnstt.git /tmp/dnstt-build
    cd /tmp/dnstt-build

    # 3. Build server (sesuai instruksi resmi: cd dnstt-server; go build)
    echo "Building dnstt-server..."
    (
        cd dnstt-server
        CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o dnstt-server .
    )

    # 4. Build client (sesuai instruksi resmi: cd dnstt-client; go build)
    echo "Building dnstt-client..."
    (
        cd dnstt-client
        CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o dnstt-client .
    )

    # 5. Siapkan direktori & salin binary hasil build
    mkdir -p /etc/slowdns
    cd /etc/slowdns
    cp /tmp/dnstt-build/dnstt-server/dnstt-server /etc/slowdns/dnstt-server
    cp /tmp/dnstt-build/dnstt-client/dnstt-client /etc/slowdns/dnstt-client
    chmod +x /etc/slowdns/dnstt-server /etc/slowdns/dnstt-client

    # 6. Generate keypair (hanya jika belum ada, agar client lama tetap valid)
    if [[ ! -f /etc/slowdns/server.key || ! -f /etc/slowdns/server.pub ]]; then
        ./dnstt-server -gen-key -privkey-file server.key -pubkey-file server.pub
    fi
    chmod +x /etc/slowdns/*

    # 7. Unduh service unit & sesuaikan NS_DOMAIN
    wget -O /etc/systemd/system/client.service "${REPOS}Fls/client" >/dev/null 2>&1
    wget -O /etc/systemd/system/server.service "${REPOS}Fls/server" >/dev/null 2>&1
    sed -i "s/xxxx/$NS_DOMAIN/g" /etc/systemd/system/client.service
    sed -i "s/xxxx/$NS_DOMAIN/g" /etc/systemd/system/server.service

    # 8. Bersihkan direktori build
    rm -rf /tmp/dnstt-build
    echo "dnstt build from source selesai."
}
# <<< REVISI BUILD DARI SOURCE

ns_domain_cloudflare
setup_dnstt